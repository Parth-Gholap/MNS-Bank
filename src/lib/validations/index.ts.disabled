// Validation Schemas for Mahanagar Bank Website

import { constants } from '@/lib/constants';

export interface ValidationRule {
  required?: boolean;
  minLength?: number;
  maxLength?: number;
  pattern?: RegExp;
  custom?: (value: any) => boolean | string;
}

export interface ValidationResult {
  isValid: boolean;
  error?: string;
}

// Common validation rules
export const validationRules = {
  required: {
    required: true,
    custom: (value: any) => value !== null && value !== undefined && value.toString().trim() !== ''
  },

  email: {
    required: true,
    pattern: constants.patterns.email,
    custom: (value: any) => constants.patterns.email.test(value)
  },

  mobile: {
    required: true,
    pattern: constants.patterns.mobile,
    custom: (value: any) => constants.patterns.mobile.test(value)
  },

  pincode: {
    required: true,
    pattern: constants.patterns.pincode,
    custom: (value: any) => constants.patterns.pincode.test(value)
  },

  aadhaar: {
    required: true,
    pattern: constants.patterns.aadhaar,
    custom: (value: any) => constants.patterns.aadhaar.test(value)
  },

  pan: {
    required: true,
    pattern: constants.patterns.pan,
    custom: (value: any) => constants.patterns.pan.test(value)
  },

  ifsc: {
    required: true,
    pattern: constants.patterns.ifsc,
    custom: (value: any) => constants.patterns.ifsc.test(value)
  },

  amount: {
    required: true,
    custom: (value: any) => {
      const num = parseFloat(value);
      return !isNaN(num) && num > 0 && num <= constants.maxLoanAmount;
    }
  },

  loanAmount: {
    required: true,
    custom: (value: any) => {
      const num = parseFloat(value);
      return !isNaN(num) && num >= constants.minLoanAmount && num <= constants.maxLoanAmount;
    }
  },

  interestRate: {
    required: true,
    custom: (value: any) => {
      const num = parseFloat(value);
      return !isNaN(num) && num >= constants.minInterestRate && num <= constants.maxInterestRate;
    }
  },

  tenure: {
    required: true,
    custom: (value: any) => {
      const num = parseInt(value);
      return !isNaN(num) && num > 0 && num <= 360; // Max 30 years
    }
  },

  message: {
    required: false,
    maxLength: constants.maxFormMessageLength,
    custom: (value: any) => {
      const str = value.toString();
      return str.length <= constants.maxFormMessageLength;
    }
  },

  file: {
    required: false,
    custom: (value: any) => {
      if (value instanceof File) {
        return value.size <= constants.maxFileSize;
      }
      return false;
    }
  }
};

// Validation functions
export const validators = {
  // Text validation
  validateRequired: (value: any): ValidationResult => {
    const isValid = validationRules.required.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.REQUIRED_FIELD as keyof typeof constants.ERROR_MESSAGES]
    };
  },

  validateEmail: (value: any): ValidationResult => {
    const rule = validationRules.email;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_EMAIL as keyof typeof constants.ERROR_MESSAGES]
    };
  },

  validateMobile: (value: any): ValidationResult => {
    const rule = validationRules.mobile;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_MOBILE]
    };
  },

  validatePincode: (value: any): ValidationResult => {
    const rule = validationRules.pincode;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_PINCODE]
    };
  },

  validateAadhaar: (value: any): ValidationResult => {
    const rule = validationRules.aadhaar;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_AADHAAR]
    };
  },

  validatePan: (value: any): ValidationResult => {
    const rule = validationRules.pan;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_PAN]
    };
  },

  validateIFSC: (value: any): ValidationResult => {
    const rule = validationRules.ifsc;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_IFSC]
    };
  },

  // Numeric validation
  validateAmount: (value: any, min?: number, max?: number): ValidationResult => {
    const rule = validationRules.amount;
    const isValid = rule.custom?.(value) && 
                   (!min || parseFloat(value) >= min) && 
                   (!max || parseFloat(value) <= max);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_AMOUNT]
    };
  },

  validateLoanAmount: (value: any): ValidationResult => {
    const rule = validationRules.loanAmount;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_AMOUNT]
    };
  },

  validateInterestRate: (value: any): ValidationResult => {
    const rule = validationRules.interestRate;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_RATE]
    };
  },

  validateTenure: (value: any): ValidationResult => {
    const rule = validationRules.tenure;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_TENURE]
    };
  },

  // File validation
  validateFile: (value: any, allowedTypes?: string[], maxSize?: number): ValidationResult => {
    const rule = validationRules.file;
    const isValid = rule.custom?.(value) && 
                   (!allowedTypes || allowedTypes.includes(value.type)) && 
                   (!maxSize || value.size <= maxSize);
    return {
      isValid,
      error: isValid ? undefined : 
               value.size > (maxSize || constants.maxFileSize) ? 
               constants.ERROR_MESSAGES[constants.ERROR_CODES.FILE_TOO_LARGE] :
               constants.ERROR_MESSAGES[constants.ERROR_CODES.INVALID_FILE_TYPE]
    };
  },

  validateMessage: (value: any, maxLength?: number): ValidationResult => {
    const rule = validationRules.message;
    const isValid = rule.custom?.(value);
    return {
      isValid,
      error: isValid ? undefined : constants.ERROR_MESSAGES[constants.ERROR_CODES.REQUIRED_FIELD]
    };
  }
};

// Form validation
export const validateForm = (formData: Record<string, any>, validationSchema: Record<string, ValidationRule>): ValidationResult => {
  const errors: string[] = [];

  for (const [field, rules] of Object.entries(validationSchema)) {
    const value = formData[field];
    
    // Check if required
    if (rules.required && (!value || value.toString().trim() === '')) {
      errors.push(`${field}: ${constants.ERROR_MESSAGES[constants.ERROR_CODES.REQUIRED_FIELD]}`);
      continue;
    }

    // Check min length
    if (rules.minLength && value && value.toString().length < rules.minLength) {
      errors.push(`${field}: Minimum ${rules.minLength} characters required`);
      continue;
    }

    // Check max length
    if (rules.maxLength && value && value.toString().length > rules.maxLength) {
      errors.push(`${field}: Maximum ${rules.maxLength} characters allowed`);
      continue;
    }

    // Check pattern
    if (rules.pattern && value && !rules.pattern.test(value.toString())) {
      errors.push(`${field}: Invalid format`);
      continue;
    }

    // Check custom validation
    if (rules.custom && !rules.custom(value)) {
      errors.push(`${field}: Invalid value`);
    }
  }

  return {
    isValid: errors.length === 0,
    error: errors.length > 0 ? errors.join('; ') : undefined
  };
};

// Inquiry form validation
export const validateInquiryForm = (formData: Record<string, any>): ValidationResult => {
  const schema = {
    fullName: validationRules.required,
    mobileNumber: validationRules.mobile,
    email: {
      ...validationRules.email,
      required: false
    },
    message: validationRules.message,
    preferredBranch: validationRules.required
  };

  return validateForm(formData, schema);
};

// EMI Calculator validation
export const validateEMICalculator = (formData: Record<string, any>): ValidationResult => {
  const schema = {
    loanAmount: validationRules.loanAmount,
    interestRate: validationRules.interestRate,
    tenure: validationRules.tenure
  };

  return validateForm(formData, schema);
};

export default {
  validationRules,
  validators,
  validateForm,
  validateInquiryForm,
  validateEMICalculator
};
