export interface SecurityHeaders {
  'Content-Security-Policy'?: string;
  'X-Content-Type-Options'?: string;
  'X-Frame-Options'?: string;
  'X-XSS-Protection'?: string;
  'Strict-Transport-Security'?: string;
  'Referrer-Policy'?: string;
  'Permissions-Policy'?: string;
  'Cross-Origin-Embedder-Policy'?: string;
  'Cross-Origin-Resource-Policy'?: string;
  'Cross-Origin-Opener-Policy'?: string;
  'Expect-CT'?: string;
}

export interface CSPConfig {
  'default-src'?: string[];
  'script-src'?: string[];
  'style-src'?: string[];
  'img-src'?: string[];
  'font-src'?: string[];
  'connect-src'?: string[];
  'media-src'?: string[];
  'object-src'?: string[];
  'child-src'?: string[];
  'worker-src'?: string[];
  'manifest-src'?: string[];
  'frame-src'?: string[];
  'frame-ancestors'?: string[];
  'base-uri'?: string[];
  'form-action'?: string[];
  'upgrade-insecure-requests'?: boolean;
  'block-all-mixed-content'?: boolean;
  reportUri?: string;
  reportOnly?: boolean;
}

export interface SecurityConfig {
  enableCSP: boolean;
  enableHSTS: boolean;
  enableXSSProtection: boolean;
  enableContentTypeOptions: boolean;
  enableFrameOptions: boolean;
  enableReferrerPolicy: boolean;
  enablePermissionsPolicy: boolean;
  enableCrossOriginPolicies: boolean;
  cspConfig: CSPConfig;
  hstsMaxAge: number;
  hstsIncludeSubDomains: boolean;
  hstsPreload: boolean;
  referrerPolicy: string;
  permissionsPolicy: string[];
}

class SecurityHeadersManager {
  private static instance: SecurityHeadersManager;
  private config: SecurityConfig;

  private constructor() {
    this.config = this.getDefaultConfig();
  }

  static getInstance(): SecurityHeadersManager {
    if (!SecurityHeadersManager.instance) {
      SecurityHeadersManager.instance = new SecurityHeadersManager();
    }
    return SecurityHeadersManager.instance;
  }

  private getDefaultConfig(): SecurityConfig {
    return {
      enableCSP: true,
      enableHSTS: true,
      enableXSSProtection: true,
      enableContentTypeOptions: true,
      enableFrameOptions: true,
      enableReferrerPolicy: true,
      enablePermissionsPolicy: true,
      enableCrossOriginPolicies: false,
      cspConfig: {
        'default-src': ["'self'"],
        'script-src': ["'self'", "'unsafe-inline'", "'unsafe-eval'", "https://www.googletagmanager.com"],
        'style-src': ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
        'img-src': ["'self'", "data:", "https:", "blob:"],
        'font-src': ["'self'", "https://fonts.gstatic.com"],
        'connect-src': ["'self'", "https://api.mnsbank.com", "https://www.google-analytics.com"],
        'media-src': ["'self'"],
        'object-src': ["'none'"],
        'child-src': ["'self'"],
        'worker-src': ["'self'", "blob:"],
        'manifest-src': ["'self'"],
        'frame-src': ["'none'"],
        'frame-ancestors': ["'none'"],
        'base-uri': ["'self'"],
        'form-action': ["'self'"],
        'upgrade-insecure-requests': true,
        'block-all-mixed-content': true,
        reportUri: '/api/security/csp-report',
        reportOnly: process.env.NODE_ENV === 'development'
      },
      hstsMaxAge: 31536000, // 1 year
      hstsIncludeSubDomains: true,
      hstsPreload: false,
      referrerPolicy: 'strict-origin-when-cross-origin',
      permissionsPolicy: [
        'geolocation=()',
        'microphone=()',
        'camera=()',
        'payment=()',
        'usb=()',
        'magnetometer=()',
        'gyroscope=()',
        'accelerometer=()',
        'ambient-light-sensor=()',
        'autoplay=(self)',
        'fullscreen=(self)',
        'picture-in-picture=(self)'
      ]
    };
  }

  generateCSP(config: CSPConfig): string {
    const directives: string[] = [];

    // Process each directive
    Object.entries(config).forEach(([directive, value]) => {
      if (directive === 'reportUri') {
        directives.push(`report-uri ${value}`);
        return;
      }

      if (directive === 'reportOnly') {
        return; // Handled separately
      }

      if (directive === 'upgrade-insecure-requests' && value) {
        directives.push('upgrade-insecure-requests');
        return;
      }

      if (directive === 'block-all-mixed-content' && value) {
        directives.push('block-all-mixed-content');
        return;
      }

      if (Array.isArray(value) && value.length > 0) {
        directives.push(`${directive} ${value.join(' ')}`);
      }
    });

    return directives.join('; ');
  }

  generateHeaders(): SecurityHeaders {
    const headers: SecurityHeaders = {};

    // Content Security Policy
    if (this.config.enableCSP) {
      const csp = this.generateCSP(this.config.cspConfig);
      const headerName = this.config.cspConfig.reportOnly ? 'Content-Security-Policy-Report-Only' : 'Content-Security-Policy';
      headers[headerName as keyof SecurityHeaders] = csp;
    }

    // X-Content-Type-Options
    if (this.config.enableContentTypeOptions) {
      headers['X-Content-Type-Options'] = 'nosniff';
    }

    // X-Frame-Options
    if (this.config.enableFrameOptions) {
      headers['X-Frame-Options'] = 'DENY';
    }

    // X-XSS-Protection
    if (this.config.enableXSSProtection) {
      headers['X-XSS-Protection'] = '1; mode=block';
    }

    // Strict-Transport-Security
    if (this.config.enableHSTS) {
      let hsts = `max-age=${this.config.hstsMaxAge}`;
      
      if (this.config.hstsIncludeSubDomains) {
        hsts += '; includeSubDomains';
      }
      
      if (this.config.hstsPreload) {
        hsts += '; preload';
      }
      
      headers['Strict-Transport-Security'] = hsts;
    }

    // Referrer-Policy
    if (this.config.enableReferrerPolicy) {
      headers['Referrer-Policy'] = this.config.referrerPolicy;
    }

    // Permissions-Policy
    if (this.config.enablePermissionsPolicy) {
      headers['Permissions-Policy'] = this.config.permissionsPolicy.join(', ');
    }

    // Cross-Origin Policies
    if (this.config.enableCrossOriginPolicies) {
      headers['Cross-Origin-Embedder-Policy'] = 'require-corp';
      headers['Cross-Origin-Resource-Policy'] = 'same-origin';
      headers['Cross-Origin-Opener-Policy'] = 'same-origin';
    }

    return headers;
  }

  validateCSP(csp: string): { valid: boolean; errors: string[] } {
    const errors: string[] = [];
    const directives = csp.split(';').map(d => d.trim()).filter(d => d.length > 0);

    directives.forEach(directive => {
      const [name, ...values] = directive.split(' ');
      
      // Check for dangerous values
      if (name === 'script-src' && values.includes("'unsafe-inline'")) {
        errors.push('Unsafe inline scripts are not recommended in production');
      }
      
      if (name === 'script-src' && values.includes("'unsafe-eval'")) {
        errors.push('Unsafe eval is not recommended in production');
      }
      
      if (name === 'default-src' && values.includes('*')) {
        errors.push('Wildcard in default-src is not secure');
      }
      
      if (name === 'object-src' && !values.includes("'none'")) {
        errors.push('object-src should be set to none for better security');
      }
    });

    return {
      valid: errors.length === 0,
      errors
    };
  }

  updateConfig(newConfig: Partial<SecurityConfig>): void {
    this.config = { ...this.config, ...newConfig };
  }

  updateCSPConfig(newConfig: Partial<CSPConfig>): void {
    this.config.cspConfig = { ...this.config.cspConfig, ...newConfig };
  }

  getConfig(): SecurityConfig {
    return { ...this.config };
  }

  getCSPConfig(): CSPConfig {
    return { ...this.config.cspConfig };
  }

  // Utility methods for specific security scenarios
  createStrictCSP(): CSPConfig {
    return {
      'default-src': ["'self'"],
      'script-src': ["'self'"],
      'style-src': ["'self'"],
      'img-src': ["'self'", "data:", "https:"],
      'font-src': ["'self'"],
      'connect-src': ["'self'"],
      'media-src': ["'self'"],
      'object-src': ["'none'"],
      'child-src': ["'none'"],
      'worker-src': ["'self'"],
      'frame-src': ["'none'"],
      'frame-ancestors': ["'none'"],
      'base-uri': ["'self'"],
      'form-action': ["'self'"],
      'upgrade-insecure-requests': true,
      'block-all-mixed-content': true
    };
  }

  createDevelopmentCSP(): CSPConfig {
    return {
      'default-src': ["'self'"],
      'script-src': ["'self'", "'unsafe-inline'", "'unsafe-eval'", "localhost:*", "127.0.0.1:*"],
      'style-src': ["'self'", "'unsafe-inline'", "localhost:*", "127.0.0.1:*"],
      'img-src': ["'self'", "data:", "https:", "blob:", "localhost:*", "127.0.0.1:*"],
      'font-src': ["'self'", "data:", "localhost:*", "127.0.0.1:*"],
      'connect-src': ["'self'", "ws:", "wss:", "localhost:*", "127.0.0.1:*"],
      'media-src': ["'self'"],
      'object-src': ["'none'"],
      'child-src': ["'self'"],
      'worker-src': ["'self'", "blob:", "localhost:*", "127.0.0.1:*"],
      'manifest-src': ["'self'"],
      'frame-src': ["'none'"],
      'frame-ancestors': ["'none'"],
      'base-uri': ["'self'"],
      'form-action': ["'self'"],
      reportUri: '/api/security/csp-report',
      reportOnly: true
    };
  }

  createBankingCSP(): CSPConfig {
    return {
      'default-src': ["'self'"],
      'script-src': ["'self'", "https://www.googletagmanager.com", "https://www.google-analytics.com"],
      'style-src': ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
      'img-src': ["'self'", "data:", "https:", "blob:", "https://www.google-analytics.com"],
      'font-src': ["'self'", "https://fonts.gstatic.com"],
      'connect-src': ["'self'", "https://api.mnsbank.com", "https://www.google-analytics.com", "https://www.googletagmanager.com"],
      'media-src': ["'self'"],
      'object-src': ["'none'"],
      'child-src': ["'self'"],
      'worker-src': ["'self'", "blob:"],
      'manifest-src': ["'self'"],
      'frame-src': ["'none'"],
      'frame-ancestors': ["'none'"],
      'base-uri': ["'self'"],
      'form-action': ["'self'"],
      'upgrade-insecure-requests': true,
      'block-all-mixed-content': true,
      reportUri: '/api/security/csp-report'
    };
  }

  // CSP violation reporting
  async handleCSPViolation(violation: any): Promise<void> {
    try {
      // Log the violation
      console.warn('CSP Violation:', violation);

      // Send to monitoring service - temporarily disabled
      // await fetch('/api/security/csp-violation', {
      //   method: 'POST',
      //   headers: {
      //     'Content-Type': 'application/json',
      //   },
      //   body: JSON.stringify({
          violatedDirective: violation.violatedDirective,
          effectiveDirective: violation.effectiveDirective,
          originalPolicy: violation.originalPolicy,
          blockedURI: violation.blockedURI,
          documentURI: violation.documentURI,
          referrer: violation.referrer,
          sourceFile: violation.sourceFile,
          lineNumber: violation.lineNumber,
          columnNumber: violation.columnNumber,
          statusCode: violation.statusCode,
          timestamp: Date.now(),
          userAgent: navigator.userAgent
        })
      });

      // Store locally for analysis
      this.storeCSPViolation(violation);
    } catch (error) {
      console.error('Failed to handle CSP violation:', error);
    }
  }

  private storeCSPViolation(violation: any): void {
    try {
      const stored = localStorage.getItem('csp_violations');
      const violations = stored ? JSON.parse(stored) : [];
      violations.push({
        ...violation,
        timestamp: Date.now()
      });
      
      // Keep only last 100 violations
      if (violations.length > 100) {
        violations.splice(0, violations.length - 100);
      }
      
      localStorage.setItem('csp_violations', JSON.stringify(violations));
    } catch (error) {
      console.warn('Failed to store CSP violation:', error);
    }
  }

  getCSPViolations(): any[] {
    try {
      const stored = localStorage.getItem('csp_violations');
      return stored ? JSON.parse(stored) : [];
    } catch (error) {
      return [];
    }
  }

  clearCSPViolations(): void {
    localStorage.removeItem('csp_violations');
  }

  // Security analysis
  analyzeSecurity(): {
    score: number;
    issues: Array<{
      severity: 'low' | 'medium' | 'high' | 'critical';
      category: string;
      description: string;
      recommendation: string;
    }>;
    recommendations: string[];
  } {
    const issues: any[] = [];
    let score = 100;

    // Check CSP configuration
    if (!this.config.enableCSP) {
      issues.push({
        severity: 'critical',
        category: 'CSP',
        description: 'Content Security Policy is disabled',
        recommendation: 'Enable CSP to prevent XSS attacks'
      });
      score -= 30;
    } else {
      const cspConfig = this.config.cspConfig;
      
      if (cspConfig.scriptSrc?.includes("'unsafe-inline'")) {
        issues.push({
          severity: 'high',
          category: 'CSP',
          description: 'Unsafe inline scripts are allowed',
          recommendation: 'Remove unsafe-inline from script-src'
        });
        score -= 15;
      }
      
      if (cspConfig.objectSrc && !cspConfig.objectSrc.includes("'none'")) {
        issues.push({
          severity: 'medium',
          category: 'CSP',
          description: 'object-src is not set to none',
          recommendation: 'Set object-src to none to prevent plugin execution'
        });
        score -= 10;
      }
    }

    // Check other security headers
    if (!this.config.enableHSTS) {
      issues.push({
        severity: 'high',
        category: 'HTTPS',
        description: 'HSTS is not enabled',
        recommendation: 'Enable HSTS to enforce HTTPS'
      });
      score -= 20;
    }

    if (!this.config.enableXSSProtection) {
      issues.push({
        severity: 'medium',
        category: 'XSS',
        description: 'XSS protection is disabled',
        recommendation: 'Enable XSS protection header'
      });
      score -= 10;
    }

    if (!this.config.enableFrameOptions) {
      issues.push({
        severity: 'high',
        category: 'Clickjacking',
        description: 'Frame protection is disabled',
        recommendation: 'Enable X-Frame-Options'
      });
      score -= 15;
    }

    const recommendations = issues.map(issue => issue.recommendation);

    return {
      score: Math.max(0, score),
      issues,
      recommendations
    };
  }
}

// Next.js middleware helper
export function createSecurityMiddleware(config?: Partial<SecurityConfig>) {
  const manager = SecurityHeadersManager.getInstance();
  
  if (config) {
    manager.updateConfig(config);
  }

  return function middleware(request: any) {
    const headers = manager.generateHeaders();
    
    // Add headers to response
    Object.entries(headers).forEach(([key, value]) => {
      if (value) {
        request.headers.set(key, value);
      }
    });

    // Handle CSP violations
    if (request.method === 'POST' && request.url.includes('/api/security/csp-report')) {
      manager.handleCSPViolation(request.body);
    }
  };
}

// React hook for security monitoring
export function useSecurityMonitoring() {
  const manager = SecurityHeadersManager.getInstance();
  const [violations, setViolations] = useState<any[]>([]);
  const [securityAnalysis, setSecurityAnalysis] = useState(manager.analyzeSecurity());

  useEffect(() => {
    const interval = setInterval(() => {
      setViolations(manager.getCSPViolations());
      setSecurityAnalysis(manager.analyzeSecurity());
    }, 5000);

    return () => clearInterval(interval);
  }, [manager]);

  const handleViolation = useCallback((violation: any) => {
    manager.handleCSPViolation(violation);
  }, [manager]);

  return {
    violations,
    securityAnalysis,
    handleViolation,
    clearViolations: () => manager.clearCSPViolations()
  };
}

// Export singleton
export const securityHeadersManager = SecurityHeadersManager.getInstance();
export default SecurityHeadersManager;
