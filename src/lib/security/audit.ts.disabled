export interface SecurityAuditConfig {
  enableLogging: boolean;
  enableMonitoring: boolean;
  logLevel: 'debug' | 'info' | 'warn' | 'error';
  retentionDays: number;
  enableRealTimeAlerts: boolean;
  alertThresholds: {
    failedLogins: number;
    suspiciousActivity: number;
    dataAccess: number;
    errors: number;
  };
}

export interface SecurityEvent {
  id: string;
  type: 'auth' | 'data' | 'system' | 'network' | 'application';
  severity: 'low' | 'medium' | 'high' | 'critical';
  category: string;
  description: string;
  timestamp: number;
  userId?: string;
  sessionId?: string;
  ipAddress?: string;
  userAgent?: string;
  resource?: string;
  action?: string;
  result: 'success' | 'failure' | 'warning';
  metadata?: Record<string, any>;
  resolved: boolean;
  resolvedAt?: number;
  resolvedBy?: string;
}

export interface AuditReport {
  id: string;
  generatedAt: number;
  period: {
    start: number;
    end: number;
  };
  summary: {
    totalEvents: number;
    criticalEvents: number;
    highEvents: number;
    mediumEvents: number;
    lowEvents: number;
    resolvedEvents: number;
    unresolvedEvents: number;
  };
  eventsByType: Record<string, number>;
  eventsBySeverity: Record<string, number>;
  topUsers: Array<{
    userId: string;
    eventCount: number;
    lastActivity: number;
  }>;
  topIPs: Array<{
    ipAddress: string;
    eventCount: number;
    lastActivity: number;
  }>;
  trends: Array<{
    date: string;
    eventCount: number;
    severity: string;
  }>;
  recommendations: string[];
}

export interface SecurityMetrics {
  totalEvents: number;
  eventsPerHour: number;
  criticalEventRate: number;
  failureRate: number;
  uniqueUsers: number;
  uniqueIPs: number;
  topEventTypes: Array<{
    type: string;
    count: number;
    percentage: number;
  }>;
  securityScore: number;
}

class SecurityAuditor {
  private static instance: SecurityAuditor;
  private config: SecurityAuditConfig;
  private events: SecurityEvent[] = [];
  private alerts: SecurityEvent[] = [];
  private metrics: SecurityMetrics;
  private cleanupInterval: NodeJS.Timeout | null = null;

  private constructor() {
    this.config = this.getDefaultConfig();
    this.metrics = this.initializeMetrics();
    this.startCleanup();
    this.loadStoredEvents();
  }

  static getInstance(): SecurityAuditor {
    if (!SecurityAuditor.instance) {
      SecurityAuditor.instance = new SecurityAuditor();
    }
    return SecurityAuditor.instance;
  }

  private getDefaultConfig(): SecurityAuditConfig {
    return {
      enableLogging: true,
      enableMonitoring: true,
      logLevel: 'info',
      retentionDays: 90,
      enableRealTimeAlerts: true,
      alertThresholds: {
        failedLogins: 5,
        suspiciousActivity: 10,
        dataAccess: 100,
        errors: 50
      }
    };
  }

  private initializeMetrics(): SecurityMetrics {
    return {
      totalEvents: 0,
      eventsPerHour: 0,
      criticalEventRate: 0,
      failureRate: 0,
      uniqueUsers: 0,
      uniqueIPs: 0,
      topEventTypes: [],
      securityScore: 100
    };
  }

  private startCleanup(): void {
    // Clean up old events daily
    this.cleanupInterval = setInterval(() => {
      this.cleanup();
    }, 24 * 60 * 60 * 1000);
  }

  private cleanup(): void {
    const cutoffTime = Date.now() - (this.config.retentionDays * 24 * 60 * 60 * 1000);
    
    this.events = this.events.filter(event => event.timestamp > cutoffTime);
    this.alerts = this.alerts.filter(alert => alert.timestamp > cutoffTime);
    
    this.updateMetrics();
    this.saveEvents();
  }

  private loadStoredEvents(): void {
    try {
      const stored = localStorage.getItem('security_events');
      if (stored) {
        this.events = JSON.parse(stored);
      }
      
      const alertsStored = localStorage.getItem('security_alerts');
      if (alertsStored) {
        this.alerts = JSON.parse(alertsStored);
      }
      
      this.updateMetrics();
    } catch (error) {
      console.warn('Failed to load stored security events:', error);
    }
  }

  private saveEvents(): void {
    try {
      if (this.events.length > 0) {
        localStorage.setItem('security_events', JSON.stringify(this.events));
      }
      
      if (this.alerts.length > 0) {
        localStorage.setItem('security_alerts', JSON.stringify(this.alerts));
      }
    } catch (error) {
      console.warn('Failed to save security events:', error);
    }
  }

  logEvent(event: Omit<SecurityEvent, 'id' | 'timestamp' | 'resolved'>): SecurityEvent {
    const securityEvent: SecurityEvent = {
      ...event,
      id: this.generateEventId(),
      timestamp: Date.now(),
      resolved: false
    };

    this.events.push(securityEvent);
    this.updateMetrics();

    // Check for alerts
    if (this.shouldAlert(securityEvent)) {
      this.alerts.push(securityEvent);
      this.triggerAlert(securityEvent);
    }

    // Log to console in development
    if (process.env.NODE_ENV === 'development') {
      console.log(`Security Event [${event.severity.toUpperCase()}]: ${event.description}`, securityEvent);
    }

    // Send to monitoring service
    if (this.config.enableMonitoring) {
      this.sendToMonitoring(securityEvent);
    }

    this.saveEvents();
    return securityEvent;
  }

  private generateEventId(): string {
    return 'event_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
  }

  private shouldAlert(event: SecurityEvent): boolean {
    if (!this.config.enableRealTimeAlerts) {
      return false;
    }

    // Critical events always trigger alerts
    if (event.severity === 'critical') {
      return true;
    }

    // Check thresholds
    const recentEvents = this.events.filter(e => 
      e.type === event.type && 
      e.result === 'failure' &&
      (Date.now() - e.timestamp) < 3600000 // Last hour
    );

    switch (event.type) {
      case 'auth':
        return recentEvents.length >= this.config.alertThresholds.failedLogins;
      case 'data':
        return recentEvents.length >= this.config.alertThresholds.dataAccess;
      case 'system':
        return recentEvents.length >= this.config.alertThresholds.errors;
      default:
        return recentEvents.length >= this.config.alertThresholds.suspiciousActivity;
    }
  }

  private triggerAlert(event: SecurityEvent): void {
    // In a real implementation, this would send alerts to monitoring systems
    console.warn('SECURITY ALERT:', event);
    
    // Store alert for dashboard
    this.sendAlertToService(event);
  }

  private async sendAlertToService(event: SecurityEvent): Promise<void> {
    try {
      await fetch('/api/security/alerts', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(event)
      });
    } catch (error) {
      console.warn('Failed to send security alert:', error);
    }
  }

  private async sendToMonitoring(event: SecurityEvent): Promise<void> {
    try {
      await fetch('/api/security/monitoring', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(event)
      });
    } catch (error) {
      console.warn('Failed to send security event to monitoring:', error);
    }
  }

  // Specific event logging methods
  logAuthEvent(
    action: string,
    result: 'success' | 'failure',
    userId?: string,
    ipAddress?: string,
    userAgent?: string,
    metadata?: Record<string, any>
  ): SecurityEvent {
    return this.logEvent({
      type: 'auth',
      severity: result === 'failure' ? 'high' : 'low',
      category: action,
      description: `Authentication ${action}: ${result}`,
      userId,
      sessionId: this.getCurrentSessionId(),
      ipAddress,
      userAgent,
      action,
      result,
      metadata
    });
  }

  logDataEvent(
    action: string,
    resource: string,
    result: 'success' | 'failure',
    userId?: string,
    ipAddress?: string,
    metadata?: Record<string, any>
  ): SecurityEvent {
    return this.logEvent({
      type: 'data',
      severity: result === 'failure' ? 'medium' : 'low',
      category: action,
      description: `Data ${action} on ${resource}: ${result}`,
      userId,
      sessionId: this.getCurrentSessionId(),
      ipAddress,
      resource,
      action,
      result,
      metadata
    });
  }

  logSystemEvent(
    action: string,
    result: 'success' | 'failure',
    severity: 'low' | 'medium' | 'high' | 'critical',
    metadata?: Record<string, any>
  ): SecurityEvent {
    return this.logEvent({
      type: 'system',
      severity,
      category: action,
      description: `System ${action}: ${result}`,
      sessionId: this.getCurrentSessionId(),
      action,
      result,
      metadata
    });
  }

  logNetworkEvent(
    action: string,
    result: 'success' | 'failure',
    ipAddress?: string,
    userAgent?: string,
    metadata?: Record<string, any>
  ): SecurityEvent {
    return this.logEvent({
      type: 'network',
      severity: result === 'failure' ? 'medium' : 'low',
      category: action,
      description: `Network ${action}: ${result}`,
      sessionId: this.getCurrentSessionId(),
      ipAddress,
      userAgent,
      action,
      result,
      metadata
    });
  }

  logApplicationEvent(
    action: string,
    result: 'success' | 'failure',
    severity: 'low' | 'medium' | 'high' | 'critical',
    userId?: string,
    metadata?: Record<string, any>
  ): SecurityEvent {
    return this.logEvent({
      type: 'application',
      severity,
      category: action,
      description: `Application ${action}: ${result}`,
      userId,
      sessionId: this.getCurrentSessionId(),
      action,
      result,
      metadata
    });
  }

  private getCurrentSessionId(): string {
    // This would typically come from your session management system
    return 'session_' + Date.now();
  }

  private updateMetrics(): void {
    const now = Date.now();
    const oneHourAgo = now - 3600000;

    this.metrics.totalEvents = this.events.length;
    this.metrics.eventsPerHour = this.events.filter(e => e.timestamp > oneHourAgo).length;
    this.metrics.criticalEventRate = this.calculateCriticalEventRate();
    this.metrics.failureRate = this.calculateFailureRate();
    this.metrics.uniqueUsers = this.calculateUniqueUsers();
    this.metrics.uniqueIPs = this.calculateUniqueIPs();
    this.metrics.topEventTypes = this.calculateTopEventTypes();
    this.metrics.securityScore = this.calculateSecurityScore();
  }

  private calculateCriticalEventRate(): number {
    const criticalEvents = this.events.filter(e => e.severity === 'critical').length;
    return this.metrics.totalEvents > 0 ? (criticalEvents / this.metrics.totalEvents) * 100 : 0;
  }

  private calculateFailureRate(): number {
    const failureEvents = this.events.filter(e => e.result === 'failure').length;
    return this.metrics.totalEvents > 0 ? (failureEvents / this.metrics.totalEvents) * 100 : 0;
  }

  private calculateUniqueUsers(): number {
    const uniqueUsers = new Set(this.events.map(e => e.userId).filter(Boolean));
    return uniqueUsers.size;
  }

  private calculateUniqueIPs(): number {
    const uniqueIPs = new Set(this.events.map(e => e.ipAddress).filter(Boolean));
    return uniqueIPs.size;
  }

  private calculateTopEventTypes(): Array<{ type: string; count: number; percentage: number }> {
    const typeCounts: Record<string, number> = {};
    
    this.events.forEach(event => {
      typeCounts[event.type] = (typeCounts[event.type] || 0) + 1;
    });

    return Object.entries(typeCounts)
      .map(([type, count]) => ({
        type,
        count,
        percentage: this.metrics.totalEvents > 0 ? (count / this.metrics.totalEvents) * 100 : 0
      }))
      .sort((a, b) => b.count - a.count)
      .slice(0, 5);
  }

  private calculateSecurityScore(): number {
    let score = 100;

    // Deduct points for critical events
    const criticalCount = this.events.filter(e => e.severity === 'critical').length;
    score -= criticalCount * 10;

    // Deduct points for high events
    const highCount = this.events.filter(e => e.severity === 'high').length;
    score -= highCount * 5;

    // Deduct points for failures
    const failureCount = this.events.filter(e => e.result === 'failure').length;
    score -= Math.min(failureCount * 0.5, 20);

    return Math.max(0, Math.round(score));
  }

  getMetrics(): SecurityMetrics {
    return { ...this.metrics };
  }

  getEvents(filters?: {
    type?: string;
    severity?: string;
    result?: string;
    userId?: string;
    startDate?: number;
    endDate?: number;
    limit?: number;
  }): SecurityEvent[] {
    let filtered = [...this.events];

    if (filters) {
      if (filters.type) {
        filtered = filtered.filter(e => e.type === filters.type);
      }
      if (filters.severity) {
        filtered = filtered.filter(e => e.severity === filters.severity);
      }
      if (filters.result) {
        filtered = filtered.filter(e => e.result === filters.result);
      }
      if (filters.userId) {
        filtered = filtered.filter(e => e.userId === filters.userId);
      }
      if (filters.startDate) {
        filtered = filtered.filter(e => e.timestamp >= filters.startDate!);
      }
      if (filters.endDate) {
        filtered = filtered.filter(e => e.timestamp <= filters.endDate!);
      }
    }

    // Sort by timestamp (newest first)
    filtered.sort((a, b) => b.timestamp - a.timestamp);

    // Apply limit
    if (filters?.limit) {
      filtered = filtered.slice(0, filters.limit);
    }

    return filtered;
  }

  getAlerts(): SecurityEvent[] {
    return [...this.alerts].sort((a, b) => b.timestamp - a.timestamp);
  }

  generateReport(startDate?: number, endDate?: number): AuditReport {
    const now = Date.now();
    const start = startDate || (now - 24 * 60 * 60 * 1000); // Default: last 24 hours
    const end = endDate || now;

    const reportEvents = this.events.filter(e => e.timestamp >= start && e.timestamp <= end);

    const summary = {
      totalEvents: reportEvents.length,
      criticalEvents: reportEvents.filter(e => e.severity === 'critical').length,
      highEvents: reportEvents.filter(e => e.severity === 'high').length,
      mediumEvents: reportEvents.filter(e => e.severity === 'medium').length,
      lowEvents: reportEvents.filter(e => e.severity === 'low').length,
      resolvedEvents: reportEvents.filter(e => e.resolved).length,
      unresolvedEvents: reportEvents.filter(e => !e.resolved).length
    };

    const eventsByType: Record<string, number> = {};
    const eventsBySeverity: Record<string, number> = {};

    reportEvents.forEach(event => {
      eventsByType[event.type] = (eventsByType[event.type] || 0) + 1;
      eventsBySeverity[event.severity] = (eventsBySeverity[event.severity] || 0) + 1;
    });

    const topUsers = this.getTopUsers(reportEvents);
    const topIPs = this.getTopIPs(reportEvents);
    const trends = this.getTrends(reportEvents, start, end);
    const recommendations = this.generateRecommendations(reportEvents);

    return {
      id: 'report_' + Date.now(),
      generatedAt: now,
      period: { start, end },
      summary,
      eventsByType,
      eventsBySeverity,
      topUsers,
      topIPs,
      trends,
      recommendations
    };
  }

  private getTopUsers(events: SecurityEvent[]): Array<{ userId: string; eventCount: number; lastActivity: number }> {
    const userCounts: Record<string, { count: number; lastActivity: number }> = {};

    events.forEach(event => {
      if (event.userId) {
        if (!userCounts[event.userId]) {
          userCounts[event.userId] = { count: 0, lastActivity: 0 };
        }
        userCounts[event.userId].count++;
        userCounts[event.userId].lastActivity = Math.max(
          userCounts[event.userId].lastActivity,
          event.timestamp
        );
      }
    });

    return Object.entries(userCounts)
      .map(([userId, data]) => ({ userId, ...data }))
      .sort((a, b) => b.eventCount - a.eventCount)
      .slice(0, 10);
  }

  private getTopIPs(events: SecurityEvent[]): Array<{ ipAddress: string; eventCount: number; lastActivity: number }> {
    const ipCounts: Record<string, { count: number; lastActivity: number }> = {};

    events.forEach(event => {
      if (event.ipAddress) {
        if (!ipCounts[event.ipAddress]) {
          ipCounts[event.ipAddress] = { count: 0, lastActivity: 0 };
        }
        ipCounts[event.ipAddress].count++;
        ipCounts[event.ipAddress].lastActivity = Math.max(
          ipCounts[event.ipAddress].lastActivity,
          event.timestamp
        );
      }
    });

    return Object.entries(ipCounts)
      .map(([ipAddress, data]) => ({ ipAddress, ...data }))
      .sort((a, b) => b.eventCount - a.eventCount)
      .slice(0, 10);
  }

  private getTrends(events: SecurityEvent[], start: number, end: number): Array<{ date: string; eventCount: number; severity: string }> {
    const trends: Record<string, Record<string, number>> = {};

    events.forEach(event => {
      const date = new Date(event.timestamp).toISOString().split('T')[0];
      
      if (!trends[date]) {
        trends[date] = {};
      }
      
      trends[date][event.severity] = (trends[date][event.severity] || 0) + 1;
    });

    return Object.entries(trends)
      .map(([date, severities]) => {
        const maxSeverity = Object.entries(severities)
          .sort(([, a], [, b]) => b - a)[0]?.[0] || 'low';
        
        const totalEvents = Object.values(severities).reduce((sum, count) => sum + count, 0);
        
        return { date, eventCount: totalEvents, severity: maxSeverity };
      })
      .sort((a, b) => a.date.localeCompare(b.date));
  }

  private generateRecommendations(events: SecurityEvent[]): string[] {
    const recommendations: string[] = [];
    
    const failureRate = this.calculateFailureRate();
    const criticalCount = events.filter(e => e.severity === 'critical').length;
    const authFailures = events.filter(e => e.type === 'auth' && e.result === 'failure').length;

    if (failureRate > 20) {
      recommendations.push('High failure rate detected. Review system logs and error handling.');
    }

    if (criticalCount > 0) {
      recommendations.push('Critical security events detected. Immediate investigation required.');
    }

    if (authFailures > 10) {
      recommendations.push('High number of authentication failures. Consider implementing additional security measures.');
    }

    const uniqueIPs = this.calculateUniqueIPs();
    if (uniqueIPs > 1000) {
      recommendations.push('High number of unique IP addresses. Consider implementing IP-based rate limiting.');
    }

    if (recommendations.length === 0) {
      recommendations.push('Security posture looks good. Continue monitoring.');
    }

    return recommendations;
  }

  resolveEvent(eventId: string, resolvedBy: string): boolean {
    const event = this.events.find(e => e.id === eventId);
    if (event) {
      event.resolved = true;
      event.resolvedAt = Date.now();
      event.resolvedBy = resolvedBy;
      this.saveEvents();
      return true;
    }
    return false;
  }

  updateConfig(newConfig: Partial<SecurityAuditConfig>): void {
    this.config = { ...this.config, ...newConfig };
  }

  clearEvents(beforeDate?: number): void {
    if (beforeDate) {
      this.events = this.events.filter(e => e.timestamp >= beforeDate);
    } else {
      this.events = [];
    }
    this.updateMetrics();
    this.saveEvents();
  }

  destroy(): void {
    if (this.cleanupInterval) {
      clearInterval(this.cleanupInterval);
    }
    this.saveEvents();
  }
}

// React hook for security monitoring
export function useSecurityMonitoring() {
  const auditor = SecurityAuditor.getInstance();
  const [metrics, setMetrics] = useState<SecurityMetrics>(auditor.getMetrics());
  const [alerts, setAlerts] = useState<SecurityEvent[]>(auditor.getAlerts());
  const [events, setEvents] = useState<SecurityEvent[]>(auditor.getEvents({ limit: 50 }));

  useEffect(() => {
    const interval = setInterval(() => {
      setMetrics(auditor.getMetrics());
      setAlerts(auditor.getAlerts());
      setEvents(auditor.getEvents({ limit: 50 }));
    }, 5000);

    return () => clearInterval(interval);
  }, [auditor]);

  const logEvent = useCallback((event: Omit<SecurityEvent, 'id' | 'timestamp' | 'resolved'>) => {
    return auditor.logEvent(event);
  }, [auditor]);

  const generateReport = useCallback((startDate?: number, endDate?: number) => {
    return auditor.generateReport(startDate, endDate);
  }, [auditor]);

  return {
    metrics,
    alerts,
    events,
    logEvent,
    generateReport,
    resolveEvent: (eventId: string, resolvedBy: string) => auditor.resolveEvent(eventId, resolvedBy)
  };
}

// Export singleton
export const securityAuditor = SecurityAuditor.getInstance();
export default SecurityAuditor;
