import React, { ComponentType } from 'react';
import dynamic from 'next/dynamic';

export interface DynamicImportOptions {
  loading?: ComponentType<{ isLoading?: boolean; error?: Error; pastDelay?: boolean }>;
  ssr?: boolean;
  timeout?: number;
  retryCount?: number;
  retryDelay?: number;
}

export interface BundleChunk {
  id: string;
  name: string;
  size: number;
  loaded: boolean;
  loading: boolean;
  error?: Error | null;
}

class CodeSplittingManager {
  private static instance: CodeSplittingManager;
  private chunks: Map<string, BundleChunk> = new Map();
  private loadingPromises: Map<string, Promise<any>> = new Map();
  private retryAttempts: Map<string, number> = new Map();

  private constructor() {
    this.initializeChunkTracking();
  }

  static getInstance(): CodeSplittingManager {
    if (!CodeSplittingManager.instance) {
      CodeSplittingManager.instance = new CodeSplittingManager();
    }
    return CodeSplittingManager.instance;
  }

  private initializeChunkTracking(): void {
    if (typeof window !== 'undefined' && 'performance' in window) {
      // Monitor chunk loading performance
      const observer = new PerformanceObserver((list) => {
        list.getEntries().forEach((entry) => {
          if (entry.name.includes('chunk')) {
            this.updateChunkStatus(entry.name, {
              loaded: true,
              loading: false,
              size: (entry as any).transferSize || 0
            });
          }
        });
      });

      observer.observe({ entryTypes: ['resource'] });
    }
  }

  private updateChunkStatus(chunkId: string, updates: Partial<BundleChunk>): void {
    const existingChunk = this.chunks.get(chunkId);
    if (existingChunk) {
      this.chunks.set(chunkId, { ...existingChunk, ...updates });
    } else {
      this.chunks.set(chunkId, {
        id: chunkId,
        name: chunkId,
        size: 0,
        loaded: false,
        loading: false,
        ...updates
      });
    }
  }

  createDynamicComponent<T extends ComponentType<any>>(
    importFunction: () => Promise<{ default: T }>,
    options: DynamicImportOptions = {}
  ): ComponentType<any> {
    const {
      loading: LoadingComponent,
      ssr = false,
      timeout = 10000,
      retryCount = 3,
      retryDelay = 1000
    } = options;

    const chunkId = this.generateChunkId(importFunction.toString());

    return dynamic(importFunction, {
      ssr,
      loading: LoadingComponent ? (props) => {
        this.updateChunkStatus(chunkId, { loading: true });
        
        if (props.error) {
          this.updateChunkStatus(chunkId, { 
            loading: false, 
            error: props.error 
          });
          return <div>Error loading component: {props.error.message}</div>;
        }
        
        return <LoadingComponent isLoading={props.isLoading} />;
      } : undefined
    }
        this.updateChunkStatus(chunkId, { 
          loading: false, 
          error 
        });
        
        // Retry logic
        const attempts = this.retryAttempts.get(chunkId) || 0;
        if (attempts < retryCount) {
          this.retryAttempts.set(chunkId, attempts + 1);
          
          setTimeout(() => {
            this.retryLoad(importFunction, chunkId);
          }, retryDelay * Math.pow(2, attempts)); // Exponential backoff
        }
      }
    });
  }

  private async retryLoad<T>(
    importFunction: () => Promise<{ default: T }>,
    chunkId: string
  ): Promise<void> {
    try {
      this.updateChunkStatus(chunkId, { loading: true, error: undefined });
      await importFunction();
      this.updateChunkStatus(chunkId, { loading: false, loaded: true });
    } catch (error) {
      this.updateChunkStatus(chunkId, { 
        loading: false, 
        error: error as Error 
      });
    }
  }

  // Public method to generate chunk ID
  public generateChunkId(importString: string): string {
    // Generate a consistent ID based on the import function
    const hash = this.simpleHash(importString);
    return `chunk_${hash}`;
  }

  private generateChunkId(importString: string): string {
    // Generate a consistent ID based on the import function
    const hash = this.simpleHash(importString);
    return `chunk_${hash}`;
  }

  private simpleHash(str: string): string {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
      const char = str.charCodeAt(i);
      hash = ((hash << 5) - hash) + char;
      hash = hash & hash; // Convert to 32-bit integer
    }
    return Math.abs(hash).toString(36);
  }

  preloadChunk(importFunction: () => Promise<any>): Promise<void> {
    const chunkId = this.generateChunkId(importFunction.toString());
    
    if (this.loadingPromises.has(chunkId)) {
      return this.loadingPromises.get(chunkId)!;
    }

    const loadingPromise = this.loadChunk(importFunction, chunkId);
    this.loadingPromises.set(chunkId, loadingPromise);
    
    return loadingPromise;
  }

  private async loadChunk(
    importFunction: () => Promise<any>,
    chunkId: string
  ): Promise<void> {
    try {
      this.updateChunkStatus(chunkId, { loading: true });
      await importFunction();
      this.updateChunkStatus(chunkId, { 
        loading: false, 
        loaded: true 
      });
    } catch (error) {
      this.updateChunkStatus(chunkId, { 
        loading: false, 
        error: error as Error 
      });
      throw error;
    }
  }

  preloadChunks(importFunctions: Array<() => Promise<any>>): Promise<void[]> {
    return Promise.all(importFunctions.map(fn => this.preloadChunk(fn)));
  }

  getChunkStatus(chunkId: string): BundleChunk | undefined {
    return this.chunks.get(chunkId);
  }

  getAllChunks(): BundleChunk[] {
    return Array.from(this.chunks.values());
  }

  getLoadedChunks(): BundleChunk[] {
    return this.getAllChunks().filter(chunk => chunk.loaded);
  }

  getLoadingChunks(): BundleChunk[] {
    return this.getAllChunks().filter(chunk => chunk.loading);
  }

  getErrorChunks(): BundleChunk[] {
    return this.getAllChunks().filter(chunk => chunk.error);
  }

  getTotalBundleSize(): number {
    return this.getAllChunks().reduce((total, chunk) => total + chunk.size, 0);
  }

  getLoadedBundleSize(): number {
    return this.getLoadedChunks().reduce((total, chunk) => total + chunk.size, 0);
  }

  getBundleStats(): {
    total: number;
    loaded: number;
    loading: number;
    error: number;
    totalSize: number;
    loadedSize: number;
    loadingProgress: number;
  } {
    const all = this.getAllChunks();
    const loaded = this.getLoadedChunks();
    const loading = this.getLoadingChunks();
    const error = this.getErrorChunks();
    
    return {
      total: all.length,
      loaded: loaded.length,
      loading: loading.length,
      error: error.length,
      totalSize: this.getTotalBundleSize(),
      loadedSize: this.getLoadedBundleSize(),
      loadingProgress: this.getTotalBundleSize() > 0 
        ? (this.getLoadedBundleSize() / this.getTotalBundleSize()) * 100 
        : 0
    };
  }

  clearCache(): void {
    this.chunks.clear();
    this.loadingPromises.clear();
    this.retryAttempts.clear();
  }

  // Utility functions for common dynamic imports
  createLazyComponent<T extends ComponentType<any>>(
    importFunction: () => Promise<{ default: T }>,
    options?: DynamicImportOptions
  ): T {
    return this.createDynamicComponent(importFunction, options) as T;
  }

  createLazyPage<T extends ComponentType<any>>(
    importFunction: () => Promise<{ default: T }>,
    options?: DynamicImportOptions
  ): T {
    return this.createDynamicComponent(importFunction, {
      ...options,
      ssr: false // Pages are typically client-side only for better performance
    }) as T;
  }

  createLazyModal<T extends ComponentType<any>>(
    importFunction: () => Promise<{ default: T }>,
    options?: DynamicImportOptions
  ): T {
    return this.createDynamicComponent(importFunction, {
      ...options,
      ssr: false,
      timeout: 5000 // Modals should load quickly
    }) as T;
  }

  createLazyChart<T extends ComponentType<any>>(
    importFunction: () => Promise<{ default: T }>,
    options?: DynamicImportOptions
  ): T {
    return this.createDynamicComponent(importFunction, {
      ...options,
      ssr: false,
      timeout: 15000 // Charts might be larger
    }) as T;
  }

  createLazyForm<T extends ComponentType<any>>(
    importFunction: () => Promise<{ default: T }>,
    options?: DynamicImportOptions
  ): T {
    return this.createDynamicComponent(importFunction, {
      ...options,
      ssr: false,
      timeout: 8000 // Forms should be reasonably fast
    }) as T;
  }
}

// React hook for code splitting
export function useCodeSplitting() {
  const manager = CodeSplittingManager.getInstance();

  const preloadChunk = (importFunction: () => Promise<any>) => {
    return manager.preloadChunk(importFunction);
  };

  const preloadChunks = (importFunctions: Array<() => Promise<any>>) => {
    return manager.preloadChunks(importFunctions);
  };

  const getBundleStats = () => {
    return manager.getBundleStats();
  };

  const getChunkStatus = (chunkId: string) => {
    return manager.getChunkStatus(chunkId);
  };

  const getAllChunks = () => {
    return manager.getAllChunks();
  };

  return {
    preloadChunk,
    preloadChunks,
    getBundleStats,
    getChunkStatus,
    getAllChunks
  };
}

// Predefined loading components
export const DefaultLoadingComponent: ComponentType<{ isLoading?: boolean }> = ({ isLoading }) => (
  <div className="loading-container">
    <div className="loading-spinner" />
    <div className="loading-text">
      {isLoading ? 'Loading...' : 'Preparing...'}
    </div>
    <style jsx>{`
      .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        min-height: 200px;
      }
      
      .loading-spinner {
        width: 32px;
        height: 32px;
        border: 3px solid #f3f3f3;
        border-top: 3px solid #007bff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 1rem;
      }
      
      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
      
      .loading-text {
        color: #666;
        font-size: 0.875rem;
      }
    `}</style>
  </div>
);

export const MinimalLoadingComponent: ComponentType = () => (
  <div className="minimal-loading">
    <div className="loading-dots">
      <span>.</span>
      <span>.</span>
      <span>.</span>
    </div>
    <style jsx>{`
      .minimal-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }
      
      .loading-dots {
        display: flex;
        gap: 2px;
      }
      
      .loading-dots span {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #007bff;
        animation: bounce 1.4s infinite ease-in-out both;
      }
      
      .loading-dots span:nth-child(1) {
        animation-delay: -0.32s;
      }
      
      .loading-dots span:nth-child(2) {
        animation-delay: -0.16s;
      }
      
      @keyframes bounce {
        0%, 80%, 100% {
          transform: scale(0);
        }
        40% {
          transform: scale(1);
        }
      }
    `}</style>
  </div>
);

export const SkeletonLoadingComponent: ComponentType<{ width?: string; height?: string }> = ({ 
  width = '100%', 
  height = '20px' 
}) => (
  <div className="skeleton-loading" style={{ width, height }}>
    <div className="skeleton-shimmer" />
    <style jsx>{`
      .skeleton-loading {
        background: #f0f0f0;
        border-radius: 4px;
        position: relative;
        overflow: hidden;
      }
      
      .skeleton-shimmer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.4),
          transparent
        );
        animation: shimmer 2s infinite;
      }
      
      @keyframes shimmer {
        0% {
          transform: translateX(-100%);
        }
        100% {
          transform: translateX(100%);
        }
      }
    `}</style>
  </div>
);

// Export singleton
export const codeSplittingManager = CodeSplittingManager.getInstance();
export default CodeSplittingManager;
