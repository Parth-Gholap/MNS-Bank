import React, { useState, useEffect, useCallback } from 'react';

export interface PerformanceMetrics {
  // Core Web Vitals
  fcp?: number; // First Contentful Paint
  lcp?: number; // Largest Contentful Paint
  fid?: number; // First Input Delay
  cls?: number; // Cumulative Layout Shift
  ttfb?: number; // Time to First Byte
  
  // Custom metrics
  pageLoadTime?: number;
  domContentLoaded?: number;
  resourceLoadTime?: number;
  apiResponseTime?: number;
  renderTime?: number;
  
  // Memory usage
  memoryUsage?: number;
  memoryLimit?: number;
  
  // Network metrics
  resourceCount?: number;
  totalSize?: number;
  cachedResources?: number;
}

export interface PerformanceAlert {
  type: 'error' | 'warning' | 'info' | 'critical';
  message: string;
  timestamp: number;
  metric?: string;
  threshold?: number;
}

export interface PerformanceMetrics {
  // Core Web Vitals
  fcp?: number; // First Contentful Paint
  lcp?: number; // Largest Contentful Paint
  fid?: number; // First Input Delay
  cls?: number; // Cumulative Layout Shift
  ttfb?: number; // Time to First Byte
  
  // Custom metrics
  pageLoadTime?: number;
  domContentLoaded?: number;
  resourceLoadTime?: number;
  apiResponseTime?: number;
  renderTime?: number;
  
  // Memory usage
  memoryUsage?: number;
  memoryLimit?: number;
  
  // Network metrics
  resourceCount?: number;
  totalSize?: number;
  cachedResources?: number;
  
  // User interactions
  interactionTime?: number;
  clickToResponse?: number;
  
  // Error tracking
  errorCount?: number;
  errorRate?: number;
  
  // Timestamps
  timestamp: number;
  sessionId: string;
  userId?: string;
  pageUrl: string;
  userAgent: string;
}

export interface PerformanceAlert {
  id: string;
  type: 'warning' | 'error' | 'critical';
  metric: string;
  value: number;
  threshold: number;
  message: string;
  timestamp: number;
  resolved: boolean;
  resolvedAt?: number;
}

export interface PerformanceThreshold {
  metric: keyof PerformanceMetrics;
  threshold: number;
  operator: '>' | '<' | '>=' | '<=';
  severity: 'warning' | 'error' | 'critical';
  message: string;
}

export interface MonitoringConfig {
  enabled: boolean;
  sampleRate: number; // 0-1
  thresholds: PerformanceThreshold[];
  alertCooldown: number; // milliseconds
  maxAlertsPerHour: number;
  enableRealUserMonitoring: boolean;
  enableSyntheticMonitoring: boolean;
  enableErrorTracking: boolean;
  enableNetworkMonitoring: boolean;
  enableMemoryMonitoring: boolean;
}

class PerformanceMonitor {
  private static instance: PerformanceMonitor;
  private config: MonitoringConfig;
  private metrics: PerformanceMetrics[] = [];
  private alerts: PerformanceAlert[] = [];
  private observers: PerformanceObserver[] = [];
  private alertHistory: Map<string, number> = new Map();
  private sessionId: string;
  private isMonitoring: boolean = false;

  private constructor() {
    this.sessionId = this.generateSessionId();
    this.config = this.getDefaultConfig();
    this.initializeMonitoring();
  }

  static getInstance(): PerformanceMonitor {
    if (!PerformanceMonitor.instance) {
      PerformanceMonitor.instance = new PerformanceMonitor();
    }
    return PerformanceMonitor.instance;
  }

  private getDefaultConfig(): MonitoringConfig {
    return {
      enabled: true,
      sampleRate: 1.0,
      thresholds: [
        { metric: 'fcp', threshold: 1800, operator: '>', severity: 'warning', message: 'First Contentful Paint is slow' },
        { metric: 'lcp', threshold: 2500, operator: '>', severity: 'warning', message: 'Largest Contentful Paint is slow' },
        { metric: 'fid', threshold: 100, operator: '>', severity: 'warning', message: 'First Input Delay is high' },
        { metric: 'cls', threshold: 0.1, operator: '>', severity: 'warning', message: 'Cumulative Layout Shift is high' },
        { metric: 'ttfb', threshold: 600, operator: '>', severity: 'warning', message: 'Time to First Byte is slow' },
        { metric: 'pageLoadTime', threshold: 3000, operator: '>', severity: 'error', message: 'Page load time is too slow' },
        { metric: 'apiResponseTime', threshold: 2000, operator: '>', severity: 'warning', message: 'API response time is slow' },
        { metric: 'memoryUsage', threshold: 0.8, operator: '>', severity: 'error', message: 'Memory usage is high' },
        { metric: 'errorRate', threshold: 0.05, operator: '>', severity: 'critical', message: 'Error rate is too high' }
      ],
      alertCooldown: 300000, // 5 minutes
      maxAlertsPerHour: 10,
      enableRealUserMonitoring: true,
      enableSyntheticMonitoring: false,
      enableErrorTracking: true,
      enableNetworkMonitoring: true,
      enableMemoryMonitoring: true
    };
  }

  private generateSessionId(): string {
    return 'session_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
  }

  private initializeMonitoring(): void {
    if (!this.config.enabled || typeof window === 'undefined') {
      return;
    }

    this.setupPerformanceObservers();
    this.setupErrorTracking();
    this.setupNetworkMonitoring();
    this.setupMemoryMonitoring();
    this.isMonitoring = true;
  }

  private setupPerformanceObservers(): void {
    if (!('PerformanceObserver' in window)) {
      return;
    }

    // Core Web Vitals
    this.observeWebVitals();
    
    // Resource timing
    this.observeResourceTiming();
    
    // Navigation timing
    this.observeNavigationTiming();
    
    // Paint timing
    this.observePaintTiming();
  }

  private observeWebVitals(): void {
    try {
      // LCP (Largest Contentful Paint)
      const lcpObserver = new PerformanceObserver((list) => {
        const entries = list.getEntries();
        const lastEntry = entries[entries.length - 1] as PerformanceEntry;
        this.recordMetric('lcp', lastEntry.startTime);
      });
      lcpObserver.observe({ entryTypes: ['largest-contentful-paint'] });
      this.observers.push(lcpObserver);

      // FID (First Input Delay)
      const fidObserver = new PerformanceObserver((list) => {
        const entries = list.getEntries();
        entries.forEach((entry: any) => {
          this.recordMetric('fid', entry.processingStart - entry.startTime);
        });
      });
      fidObserver.observe({ entryTypes: ['first-input'] });
      this.observers.push(fidObserver);

      // CLS (Cumulative Layout Shift)
      let clsValue = 0;
      const clsObserver = new PerformanceObserver((list) => {
        list.getEntries().forEach((entry: any) => {
          if (!entry.hadRecentInput) {
            clsValue += entry.value;
            this.recordMetric('cls', clsValue);
          }
        });
      });
      clsObserver.observe({ entryTypes: ['layout-shift'] });
      this.observers.push(clsObserver);
    } catch (error) {
      console.warn('Failed to setup Web Vitals observers:', error);
    }
  }

  private observeResourceTiming(): void {
    try {
      const resourceObserver = new PerformanceObserver((list) => {
        const entries = list.getEntries();
        let totalResourceTime = 0;
        
        entries.forEach((entry: any) => {
          if (entry.responseEnd > 0) {
            totalResourceTime += (entry.responseEnd - entry.startTime);
          }
        });
        
        this.recordMetric('resourceLoadTime', totalResourceTime);
      });
      resourceObserver.observe({ entryTypes: ['resource'] });
      this.observers.push(resourceObserver);
    } catch (error) {
      console.warn('Failed to setup Resource Timing observer:', error);
    }
  }

  private observeNavigationTiming(): void {
    try {
      const navObserver = new PerformanceObserver((list) => {
        const entries = list.getEntries();
        entries.forEach((entry: any) => {
          this.recordMetric('ttfb', entry.responseStart - entry.requestStart);
          this.recordMetric('domContentLoaded', entry.domContentLoadedEventEnd - entry.navigationStart);
          this.recordMetric('pageLoadTime', entry.loadEventEnd - entry.navigationStart);
        });
      });
      navObserver.observe({ entryTypes: ['navigation'] });
      this.observers.push(navObserver);
    } catch (error) {
      console.warn('Failed to setup Navigation Timing observer:', error);
    }
  }

  private observePaintTiming(): void {
    try {
      const paintObserver = new PerformanceObserver((list) => {
        const entries = list.getEntries();
        entries.forEach((entry: any) => {
          if (entry.name === 'first-contentful-paint') {
            this.recordMetric('fcp', entry.startTime);
          }
        });
      });
      paintObserver.observe({ entryTypes: ['paint'] });
      this.observers.push(paintObserver);
    } catch (error) {
      console.warn('Failed to setup Paint Timing observer:', error);
    }
  }

  private setupErrorTracking(): void {
    if (!this.config.enableErrorTracking) {
      return;
    }

    window.addEventListener('error', (event) => {
      this.recordError('javascript', event.error?.message || event.message);
    });

    window.addEventListener('unhandledrejection', (event) => {
      this.recordError('promise-rejection', event.reason?.message || 'Unhandled promise rejection');
    });
  }

  private setupNetworkMonitoring(): void {
    if (!this.config.enableNetworkMonitoring || !('connection' in navigator)) {
      return;
    }

    const connection = (navigator as any).connection;
    this.recordMetric('connectionType', connection.effectiveType || 'unknown');
    this.recordMetric('downlink', connection.downlink || 0);
    this.recordMetric('rtt', connection.rtt || 0);

    connection.addEventListener('change', () => {
      this.recordMetric('connectionType', connection.effectiveType || 'unknown');
      this.recordMetric('downlink', connection.downlink || 0);
      this.recordMetric('rtt', connection.rtt || 0);
    });
  }

  private setupMemoryMonitoring(): void {
    if (!this.config.enableMemoryMonitoring || !('memory' in performance)) {
      return;
    }

    const checkMemory = () => {
      const memory = (performance as any).memory;
      if (memory) {
        const usage = memory.usedJSHeapSize / memory.jsHeapSizeLimit;
        this.recordMetric('memoryUsage', usage);
        this.recordMetric('memoryLimit', memory.jsHeapSizeLimit);
      }
    };

    checkMemory();
    setInterval(checkMemory, 30000); // Check every 30 seconds
  }

  recordMetric(metric: keyof PerformanceMetrics, value: number): void {
    if (!this.isMonitoring) {
      return;
    }

    const now = Date.now();
    
    // Find existing metric for this session
    let sessionMetric = this.metrics.find(m => 
      m.sessionId === this.sessionId && 
      Math.abs(m.timestamp - now) < 60000 // Within last minute
    );

    if (!sessionMetric) {
      sessionMetric = {
        timestamp: now,
        sessionId: this.sessionId,
        pageUrl: window.location.href,
        userAgent: navigator.userAgent
      };
      this.metrics.push(sessionMetric);
    }

    (sessionMetric as any)[metric] = value;

    // Check thresholds
    this.checkThresholds(metric, value);
  }

  recordError(type: string, message: string): void {
    if (!this.isMonitoring) {
      return;
    }

    const now = Date.now();
    const sessionMetric = this.metrics.find(m => 
      m.sessionId === this.sessionId && 
      Math.abs(m.timestamp - now) < 60000
    );

    if (sessionMetric) {
      sessionMetric.errorCount = (sessionMetric.errorCount || 0) + 1;
      sessionMetric.errorRate = sessionMetric.errorCount / this.getInteractionCount();
    }

    this.checkThresholds('errorRate', sessionMetric?.errorRate || 0);
  }

  private getInteractionCount(): number {
    // This would need to be tracked separately
    return 1;
  }

  private checkThresholds(metric: keyof PerformanceMetrics, value: number): void {
    const threshold = this.config.thresholds.find(t => t.metric === metric);
    if (!threshold) {
      return;
    }

    const isViolation = this.evaluateCondition(value, threshold.threshold, threshold.operator);
    
    if (isViolation) {
      this.createAlert(threshold, value);
    }
  }

  private evaluateCondition(value: number, threshold: number, operator: string): boolean {
    switch (operator) {
      case '>': return value > threshold;
      case '<': return value < threshold;
      case '>=': return value >= threshold;
      case '<=': return value <= threshold;
      default: return false;
    }
  }

  private createAlert(threshold: PerformanceThreshold, value: number): void {
    const alertKey = `${threshold.metric}_${threshold.severity}`;
    const now = Date.now();
    const lastAlert = this.alertHistory.get(alertKey);

    // Check cooldown
    if (lastAlert && (now - lastAlert) < this.config.alertCooldown) {
      return;
    }

    // Check hourly limit
    const hourlyAlerts = this.alerts.filter(alert => 
      alert.metric === threshold.metric && 
      (now - alert.timestamp) < 3600000
    ).length;

    if (hourlyAlerts >= this.config.maxAlertsPerHour) {
      return;
    }

    const alert: PerformanceAlert = {
      id: 'alert_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9),
      type: threshold.severity,
      metric: threshold.metric,
      value,
      threshold: threshold.threshold,
      message: threshold.message,
      timestamp: now,
      resolved: false
    };

    this.alerts.push(alert);
    this.alertHistory.set(alertKey, now);

    // Trigger alert callback
    this.onAlert(alert);
  }

  private onAlert(alert: PerformanceAlert): void {
    // Log to console in development
    if (process.env.NODE_ENV === 'development') {
      console.warn(`Performance Alert [${alert.type}]: ${alert.message}`, alert);
    }

    // Send to monitoring service
    this.sendAlertToService(alert);

    // Store for analytics
    this.storeAlert(alert);
  }

  private async sendAlertToService(alert: PerformanceAlert): Promise<void> {
    try {
      await fetch('/api/performance/alerts', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(alert)
      });
    } catch (error) {
      console.warn('Failed to send alert to service:', error);
    }
  }

  private storeAlert(alert: PerformanceAlert): void {
    try {
      const stored = localStorage.getItem('performance_alerts');
      const alerts = stored ? JSON.parse(stored) : [];
      alerts.push(alert);
      
      // Keep only last 100 alerts
      if (alerts.length > 100) {
        alerts.splice(0, alerts.length - 100);
      }
      
      localStorage.setItem('performance_alerts', JSON.stringify(alerts));
    } catch (error) {
      console.warn('Failed to store alert:', error);
    }
  }

  recordInteraction(interactionType: string, startTime: number): void {
    const endTime = Date.now();
    const duration = endTime - startTime;
    
    this.recordMetric('interactionTime', duration);
    
    if (interactionType === 'click') {
      this.recordMetric('clickToResponse', duration);
    }
  }

  recordApiResponse(url: string, duration: number): void {
    this.recordMetric('apiResponseTime', duration);
  }

  getMetrics(sessionId?: string): PerformanceMetrics[] {
    if (sessionId) {
      return this.metrics.filter(m => m.sessionId === sessionId);
    }
    return this.metrics;
  }

  getAlerts(resolved?: boolean): PerformanceAlert[] {
    if (resolved !== undefined) {
      return this.alerts.filter(alert => alert.resolved === resolved);
    }
    return this.alerts;
  }

  getPerformanceScore(): number {
    const latestMetrics = this.getLatestMetrics();
    if (!latestMetrics) {
      return 0;
    }

    let score = 100;
    
    // Core Web Vitals scoring
    if (latestMetrics.fcp && latestMetrics.fcp > 1800) score -= 10;
    if (latestMetrics.lcp && latestMetrics.lcp > 2500) score -= 15;
    if (latestMetrics.fid && latestMetrics.fid > 100) score -= 10;
    if (latestMetrics.cls && latestMetrics.cls > 0.1) score -= 15;
    if (latestMetrics.ttfb && latestMetrics.ttfb > 600) score -= 10;
    
    // Custom metrics scoring
    if (latestMetrics.pageLoadTime && latestMetrics.pageLoadTime > 3000) score -= 20;
    if (latestMetrics.memoryUsage && latestMetrics.memoryUsage > 0.8) score -= 15;
    if (latestMetrics.errorRate && latestMetrics.errorRate > 0.05) score -= 25;
    
    return Math.max(0, score);
  }

  private getLatestMetrics(): PerformanceMetrics | null {
    if (this.metrics.length === 0) {
      return null;
    }
    
    return this.metrics.reduce((latest, current) => 
      current.timestamp > latest.timestamp ? current : latest
    );
  }

  generateReport(): {
    summary: {
      totalMetrics: number;
      totalAlerts: number;
      performanceScore: number;
      averagePageLoadTime: number;
      averageApiResponseTime: number;
      errorRate: number;
    };
    metrics: PerformanceMetrics[];
    alerts: PerformanceAlert[];
    recommendations: string[];
  } {
    const metrics = this.getMetrics();
    const alerts = this.getAlerts();
    const score = this.getPerformanceScore();
    
    const avgPageLoadTime = metrics
      .filter(m => m.pageLoadTime)
      .reduce((sum, m) => sum + (m.pageLoadTime || 0), 0) / metrics.length || 0;
    
    const avgApiResponseTime = metrics
      .filter(m => m.apiResponseTime)
      .reduce((sum, m) => sum + (m.apiResponseTime || 0), 0) / metrics.length || 0;
    
    const errorRate = metrics
      .filter(m => m.errorRate)
      .reduce((sum, m) => sum + (m.errorRate || 0), 0) / metrics.length || 0;

    const recommendations = this.generateRecommendations(metrics, alerts);

    return {
      summary: {
        totalMetrics: metrics.length,
        totalAlerts: alerts.length,
        performanceScore: score,
        averagePageLoadTime: avgPageLoadTime,
        averageApiResponseTime: avgApiResponseTime,
        errorRate
      },
      metrics,
      alerts,
      recommendations
    };
  }

  private generateRecommendations(metrics: PerformanceMetrics[], alerts: PerformanceAlert[]): string[] {
    const recommendations: string[] = [];
    
    // Analyze metrics and generate recommendations
    const avgFCP = metrics.filter(m => m.fcp).reduce((sum, m) => sum + (m.fcp || 0), 0) / metrics.length || 0;
    if (avgFCP > 1800) {
      recommendations.push('Optimize server response time and enable compression');
    }
    
    const avgLCP = metrics.filter(m => m.lcp).reduce((sum, m) => sum + (m.lcp || 0), 0) / metrics.length || 0;
    if (avgLCP > 2500) {
      recommendations.push('Optimize image loading and reduce render-blocking resources');
    }
    
    const avgCLS = metrics.filter(m => m.cls).reduce((sum, m) => sum + (m.cls || 0), 0) / metrics.length || 0;
    if (avgCLS > 0.1) {
      recommendations.push('Ensure proper dimensions for images and media elements');
    }
    
    const avgPageLoad = metrics.filter(m => m.pageLoadTime).reduce((sum, m) => sum + (m.pageLoadTime || 0), 0) / metrics.length || 0;
    if (avgPageLoad > 3000) {
      recommendations.push('Implement code splitting and lazy loading');
    }
    
    const criticalAlerts = alerts.filter(a => a.type === 'critical');
    if (criticalAlerts.length > 0) {
      recommendations.push('Address critical performance issues immediately');
    }
    
    return recommendations;
  }

  startMonitoring(): void {
    if (!this.isMonitoring) {
      this.initializeMonitoring();
    }
  }

  stopMonitoring(): void {
    this.observers.forEach(observer => observer.disconnect());
    this.observers = [];
    this.isMonitoring = false;
  }

  clearData(): void {
    this.metrics = [];
    this.alerts = [];
    this.alertHistory.clear();
  }

  updateConfig(newConfig: Partial<MonitoringConfig>): void {
    this.config = { ...this.config, ...newConfig };
  }
}

// React hook for performance monitoring
export function usePerformanceMonitoring() {
  const monitor = PerformanceMonitor.getInstance();
  const [metrics, setMetrics] = useState<PerformanceMetrics[]>([]);
  const [alerts, setAlerts] = useState<PerformanceAlert[]>([]);
  const [score, setScore] = useState<number>(0);

  useEffect(() => {
    const interval = setInterval(() => {
      setMetrics(monitor.getMetrics());
      setAlerts(monitor.getAlerts());
      setScore(monitor.getPerformanceScore());
    }, 1000);

    return () => clearInterval(interval);
  }, [monitor]);

  const recordInteraction = useCallback((interactionType: string, startTime: number) => {
    monitor.recordInteraction(interactionType, startTime);
  }, [monitor]);

  const recordApiResponse = useCallback((url: string, duration: number) => {
    monitor.recordApiResponse(url, duration);
  }, [monitor]);

  return {
    metrics,
    alerts,
    score,
    recordInteraction,
    recordApiResponse,
    generateReport: () => monitor.generateReport()
  };
}

// Export singleton
export const performanceMonitor = PerformanceMonitor.getInstance();
export default PerformanceMonitor;
